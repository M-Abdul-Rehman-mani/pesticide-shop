# Copy to .env and replace every development-only value before deployment.
APP_ENV=development
APP_DEBUG=false
APP_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
APP_SESSION_TIMEOUT_MINUTES=30
APP_TIMEZONE=Asia/Karachi
APP_CURRENCY=PKR

DATABASE_HOST=127.0.0.1
DATABASE_PORT=5440
DATABASE_NAME=pesticide_shop
DATABASE_USER=pesticide_shop
DATABASE_PASSWORD=change-me
DATABASE_SSL_MODE=prefer
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

TEST_DATABASE_HOST=127.0.0.1
TEST_DATABASE_PORT=5441
TEST_DATABASE_NAME=pesticide_shop_test
TEST_DATABASE_USER=pesticide_shop_test
TEST_DATABASE_PASSWORD=change-test-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
REDIS_PASSWORD=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=30
OWNER_EMAIL=

DAILY_REPORT_TIME=21:00
BACKUP_DIRECTORY=backups
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESS=true
# Optional when pg_dump/pg_restore/psql are not on PATH (for example C:\Program Files\PostgreSQL\16\bin)
POSTGRES_TOOLS_DIRECTORY=
LOG_DIRECTORY=logs
